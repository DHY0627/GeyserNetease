# 统一换行符：仓库里存 LF
* text=auto

*.java      text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.properties text eol=lf
gradlew     text eol=lf
gradlew.bat text eol=crlf

# 二进制不做文本转换
*.jar   binary
*.class binary
*.png   binary
*.jpg   binary
*.gif   binary
*.zip   binary
